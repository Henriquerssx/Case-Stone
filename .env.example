# Copie para .env e preencha. Nunca versione o .env.

# YouTube Data API v3 (Google Cloud Console > APIs > YouTube Data API v3 > Credenciais)
YOUTUBE_API_KEY=

# Apify (rota de coleta do Instagram definida no kickoff): console.apify.com > Settings > API & Integrations
# Plano gratuito: US$ 5/mês de crédito, sem cartão. A coleta padrão custa ~US$ 2,20.
APIFY_TOKEN=

# Gemini API (https://aistudio.google.com/apikey) — plano gratuito
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/keys) — modelos ":free" como fallback
OPENROUTER_API_KEY=

# Ollama LOCAL (plano B offline): é um ENDEREÇO, não uma chave. Exige `ollama serve` instalado.
# Ollama Cloud (chave de ollama.com) exige créditos e não é suportado aqui.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Ordem de provedores tentados (separados por vírgula): gemini, openrouter, ollama, none
# "none" = modo template, sem LLM (usado em testes e como último recurso na demo)
LLM_PROVIDERS=gemini,openrouter,none
